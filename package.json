{
  "name": "vitest-polly",
  "version": "2.1.1",
  "description": "Recording functionality for Vitest with Polly",
  "keywords": [
    "polly",
    "vitest"
  ],
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": "https://github.com/datisthq/vitest-polly",
  "files": [
    "build"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": "./build/index.js",
  "scripts": {
    "build": "tsgo",
    "bump": "ncu -ws -u",
    "coverage": "sensible-browser coverage/index.html",
    "deps": "ncu -ws -u --cooldown 7d",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "lint": "vp fmt --check && vp lint",
    "prepare": "lefthook install",
    "release": "pnpm -r publish --access public --ignore-scripts --no-git-checks",
    "unit": "vp test",
    "test": "pnpm lint && pnpm type && pnpm unit",
    "type": "tsgo --noEmit",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --exclude=\"**/fixtures/**\" --metrics=off",
    "scan": "pnpm leaks && pnpm vulns"
  },
  "dependencies": {
    "@pollyjs/adapter-fetch": "^6.0.6",
    "@pollyjs/core": "^6.0.6",
    "@pollyjs/persister-fs": "^6.0.6"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "@vitest/coverage-v8": "4.1.11",
    "lefthook": "^2.1.5",
    "npm-check-updates": "23.1.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "vite-plus": ">=0.1.14",
    "vitest": ">=4.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
